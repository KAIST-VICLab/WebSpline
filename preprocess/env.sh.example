# Copy to preprocess/env.sh (sourced by run.sh if present) or export these yourself.
# Nothing here is required to live anywhere in particular.

# MegaSaM checkout (git clone --recursive https://github.com/mega-sam/mega-sam, see README) and its python
export MEGASAM_DIR=/path/to/mega-sam
export MEGASAM_PY=/path/to/envs/megasam/bin/python

# MoSca checkout (https://github.com/JiahuiLei/MoSca) and its python; MOSCA_ACTIVATE (optional) is
# sourced before running MoSca, e.g. to activate its env and set CUDA_HOME
export MOSCA_DIR=/path/to/MoSca
export MOSCA_PY=/path/to/envs/mosca/bin/python
# export MOSCA_ACTIVATE=/path/to/mosca_env.sh

# Python with transformers>=4.57 (Sam3VideoModel) + opencv + scipy; only for --sam3 masks
export SAM3_PY=/path/to/envs/sam3/bin/python

# Python of the WebSpline env (frame preparation, export, GT masks, optional normals); default: python
export WEBSPLINE_PY=python

# Model caches: UniDepth / SAM3 (Hugging Face; facebook/sam3 is gated, run `huggingface-cli login`)
# and MoSca's UniDepth torch.hub copy
# export HF_HOME=/path/to/hf_cache
# export TORCH_HOME=/path/to/torch_cache
